        "responses": {
          "values": [
            {
              "content": "=You are a B2B market intelligence analyst.\n\nAnalyze this company website and extract expansion signals.\n\nCompany: {{$('Google Sheets Trigger').item.json[\"companyName\"]}}\nWebsite Text: {{$json[\"websiteText\"]}}\n\nLook specifically for:\n- New office locations or geographic expansion\n- New product or service launches\n- Funding announcements\n- New partnerships or integrations\n- Hiring surges in new departments\n- New customer segments or markets entered\n- Recent milestones or growth announcements\n\nReturn ONLY this JSON, no extra text, no markdown:\n{\n  \"industry\": \"...\",\n  \"company_size\": \"startup/mid/enterprise\",\n  \"what_they_do\": \"1 clear sentence\",\n  \"expansion_signals\": [\"signal1\", \"signal2\", \"signal3\"],\n  \"expansion_stage\": \"early/active/aggressive\",\n  \"tech_signals\": [\"tools or tech mentioned\"],\n  \"buying_intent_signals\": \"high/medium/low — based on actual expansion evidence found\"\n}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
