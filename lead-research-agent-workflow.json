        "responses": {
          "values": [
            {
              "content": "=You are an expert B2B sales copywriter.\n\nWrite a 2-sentence cold email opener for a company \nthat is clearly in expansion mode.\n\nRules:\n- Reference a SPECIFIC expansion signal from their website\n- Connect their growth to a need your product solves\n- Sound like you did your homework, not like a template\n- No generic openers\n\nCompany: {{$json[\"companyName\"]}}\nWhat they do: {{$json[\"whatTheyDo\"]}}\nExpansion Signals: {{$json[\"expansionSignals\"]}}\nIndustry: {{$json[\"industry\"]}}\n\nIMPORTANT: Return ONLY 2 sentences. Plain text. No JSON. No labels."
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
