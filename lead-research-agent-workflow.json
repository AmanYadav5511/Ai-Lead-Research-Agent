        },
        "responses": {
          "values": [
            {
              "content": "=You are a B2B sales intelligence expert for a company \nthat sells to businesses actively expanding into new markets.\n\nScore this company from 1-10 on how strong their \nmarket expansion signals are right now.\n\nScoring guide:\n- 9-10: Multiple simultaneous expansion signals, \n        funded, hiring aggressively, new markets\n- 7-8: 1-2 clear expansion signals, growing steadily\n- 5-6: Some growth language but no concrete signals\n- 1-4: Stable or declining, no expansion evidence\n\nCompany: {{$json[\"companyName\"]}}\nIndustry: {{$json[\"industry\"]}}\nSize: {{$json[\"companySize\"]}}\nWhat they do: {{$json[\"whatTheyDo\"]}}\nExpansion Signals: {{$json[\"expansionSignals\"]}}\nExpansion Stage: {{$json[\"expansionStage\"]}}\nTech Signals: {{$json[\"techSignals\"]}}\nBuying Intent: {{$json[\"buyingIntent\"]}}\n\nReturn ONLY this JSON, no extra text:\n{\n  \"score\": 8,\n  \"score_reason\": \"specific expansion signals found and why they indicate active buying\"\n}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
