    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $input.item.json.output[0].content[0].text;\nconst cleaned = raw.replace(/```json|```/g, \"\").trim();\nconst parsed = JSON.parse(cleaned);\n\nconst companyName = $('Google Sheets Trigger').item.json[\"companyName\"];\nconst website = $('Google Sheets Trigger').item.json[\"website\"];\nconst rowNumber = $('Google Sheets Trigger').item.json[\"row_number\"];\n\nreturn {\n  json: {\n    companyName,\n    website,\n    rowNumber,\n    industry: parsed.industry,\n    companySize: parsed.company_size,\n    whatTheyDo: parsed.what_they_do,\n    expansionSignals: parsed.expansion_signals.join(\", \"),\n    expansionStage: parsed.expansion_stage,\n    techSignals: parsed.tech_signals.join(\", \"),\n    buyingIntent: parsed.buying_intent_signals\n  }\n};"
      },
